{
  "name": "Turkish LLM Training Datasets",
  "description": "Türkçe LLM eğitimi için kullanılan veri setleri ve kaynaklar",
  "huggingface_datasets": {
    "instruction_tuning": [
      {
        "name": "alibayram/turkish_instructions_150k",
        "description": "150K Türkçe instruction-output çifti",
        "size": "150,000",
        "type": "instruction",
        "url": "https://huggingface.co/datasets/alibayram/turkish_instructions_150k"
      },
      {
        "name": "malhajar/alpaca-turkish",
        "description": "Stanford Alpaca'nın Türkçe çevirisi",
        "size": "52,000",
        "type": "instruction",
        "url": "https://huggingface.co/datasets/malhajar/alpaca-turkish"
      },
      {
        "name": "merve/turkish_instructions",
        "description": "Türkçe instruction veri seti",
        "size": "53,000",
        "type": "instruction",
        "url": "https://huggingface.co/datasets/merve/turkish_instructions"
      },
      {
        "name": "MBZUAI/Bactrian-X",
        "description": "Çok dilli instruction seti (Türkçe dahil)",
        "size": "67,000 (TR)",
        "type": "instruction",
        "subset": "tr",
        "url": "https://huggingface.co/datasets/MBZUAI/Bactrian-X"
      }
    ],
    "pretraining": [
      {
        "name": "wikimedia/wikipedia",
        "description": "Türkçe Wikipedia makaleleri",
        "size": "~500,000 makale",
        "type": "text",
        "subset": "20231101.tr",
        "url": "https://huggingface.co/datasets/wikimedia/wikipedia"
      },
      {
        "name": "uonlp/CulturaX",
        "description": "Büyük çok dilli web corpus",
        "size": "Massive (streaming)",
        "type": "text",
        "subset": "tr",
        "url": "https://huggingface.co/datasets/uonlp/CulturaX"
      },
      {
        "name": "mc4",
        "description": "mC4 Türkçe web verisi",
        "size": "Massive (streaming)",
        "type": "text",
        "subset": "tr",
        "url": "https://huggingface.co/datasets/mc4"
      }
    ],
    "chat_conversation": [
      {
        "name": "Overfit-GM/turkish-chat",
        "description": "Türkçe sohbet veri seti",
        "size": "Varied",
        "type": "chat",
        "url": "https://huggingface.co/datasets/Overfit-GM/turkish-chat"
      }
    ],
    "evaluation": [
      {
        "name": "mukayese",
        "description": "Türkçe NLP benchmark seti",
        "type": "benchmark",
        "url": "https://github.com/mukayese-nlp"
      }
    ]
  },
  "kaggle_datasets": [
    {
      "name": "Turkish News Articles",
      "description": "Türkçe haber makaleleri",
      "url": "https://www.kaggle.com/datasets"
    },
    {
      "name": "Turkish NLP Corpus",
      "description": "Genel Türkçe NLP corpus",
      "url": "https://www.kaggle.com/datasets"
    }
  ],
  "training_config": {
    "h100": {
      "model": "Qwen/Qwen2.5-7B-Instruct",
      "batch_size": 8,
      "max_seq_len": 2048,
      "lora_r": 64,
      "lora_alpha": 128,
      "precision": "BF16",
      "quantization": false,
      "flash_attention": true,
      "estimated_time": "10-30 min"
    },
    "a100": {
      "model": "Qwen/Qwen2.5-7B-Instruct",
      "batch_size": 4,
      "max_seq_len": 2048,
      "lora_r": 32,
      "lora_alpha": 64,
      "precision": "BF16",
      "quantization": false,
      "flash_attention": true,
      "estimated_time": "20-60 min"
    },
    "t4": {
      "model": "Qwen/Qwen2.5-1.5B-Instruct",
      "batch_size": 2,
      "max_seq_len": 512,
      "lora_r": 16,
      "lora_alpha": 32,
      "precision": "FP16",
      "quantization": true,
      "flash_attention": false,
      "estimated_time": "5-10 min"
    }
  }
}
